# Environment-Variablen für das Kontaktformular (/api/contact).
# Auf Vercel unter: Project → Settings → Environment Variables eintragen.
# Lokal: als .env anlegen (wird nicht committet).

# --- Mailversand ---
# Variante A (empfohlen auf Vercel): Resend HTTP-API.
# Wird verwendet, sobald RESEND_API_KEY gesetzt ist. Absenderdomain muss in
# Resend verifiziert sein (DNS-Records; MX der Domain bleibt davon unberührt).
RESEND_API_KEY=

# Variante B: klassisches SMTP (z. B. IONOS-Mail).
# Wird nur genutzt, wenn RESEND_API_KEY leer ist.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Absender / Empfänger (für beide Varianten)
MAIL_FROM=info@korolov-it-service.de
MAIL_TO=info@korolov-it-service.de
MAIL_SUBJECT=Neue Anfrage über die Website

# --- Optional ---
# Bestätigungskopie an den Absender (1 = an)
CONTACT_SEND_CLIENT_COPY=0
# Rate-Limit pro Minute und IP
CONTACT_RATE_LIMIT_PER_MIN=5
# Debug-Details in der API-Antwort (1 = an, nur zum Testen)
CONTACT_DEBUG=0

# --- Telefonassistent (ElevenLabs post-call webhook → /api/voice-webhook) ---
# Signing-Secret des Webhooks aus ElevenLabs (Agents → Settings → Webhooks).
ELEVENLABS_WEBHOOK_SECRET=
# Empfänger der Anruf-Zusammenfassungen (Standard: MAIL_TO)
VOICE_MAIL_TO=
