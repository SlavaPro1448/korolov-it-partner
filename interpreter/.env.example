# Live-Dolmetscher DE<->RU (Twilio Media Streams + OpenAI gpt-realtime-translate).
# Als .env neben package.json anlegen (wird nicht committet).

# Öffentliche HTTPS-Adresse dieses Servers (ohne Slash am Ende), z. B. https://dolmetscher.example.de
PUBLIC_URL=
PORT=5050

OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-realtime-translate

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio-Nummer des Dolmetschers (E.164)
TWILIO_NUMBER=

# Nummer, die der Gesprächspartner bei ausgehenden Anrufen sieht (in Twilio verifizierte
# Caller ID, z. B. die Mobilnummer des Inhabers). Leer = TWILIO_NUMBER.
PEER_CALLER_ID=

# Mobilnummer des Inhabers (E.164). Nur diese Nummer darf über den Dolmetscher hinaustelefonieren.
OWNER_NUMBER=
OWNER_LANGUAGE=ru
PEER_LANGUAGE=de

# Nimmt der Inhaber den Rückruf nicht an, geht der Anrufer an diese Nummer (Telefonassistent).
# Leer = kurze Ansage und auflegen.
SECRETARY_NUMBER=

# Erlaubte Zielvorwahlen für ausgehende Anrufe (kommagetrennt)
ALLOWED_DIAL_PREFIXES=+49
# Gleichzeitige Gespräche und maximale Gesprächsdauer in Sekunden (Kostenbremse)
MAX_SESSIONS=1
MAX_CALL_SECONDS=1800

# Token für POST /admin/call (Testanruf ohne eingehende Nummer). Leer = Endpunkt aus.
ADMIN_TOKEN=

# Schlüssel für die Browser-Testseite /test?key=… (Übersetzung ohne Telefon). Leer = Seite aus.
TEST_KEY=

# Schlüssel für die Live-Textanzeige /live?key=… (Original + Übersetzung während des Gesprächs).
# Leer = Seite aus.
LIVE_KEY=

# Schlüssel für die Wählseite /call?key=… (Inhaber wird angerufen, danach die Zielnummer).
# Leer = Seite aus.
CALL_KEY=

# Firmennummer -> ElevenLabs-Telefonassistent per SIP (Webhook der Nummer: <PUBLIC_URL>/voice/secretary)
SECRETARY_SIP=

# Preise für die iOS-App (USD/Minute): Media Stream je Leg (Twilio), OpenAI-Übersetzung beide Richtungen (Schätzung)
MEDIA_STREAM_RATE=0.0044
OPENAI_RATE_PER_MIN=0.068

# Anrufe direkt aus der iOS-App (Twilio Voice SDK). API-Key + TwiML-App (Voice URL <PUBLIC_URL>/voice/client,
# Status Callback <PUBLIC_URL>/voice/client-status). Leer = nur Rückruf aufs Handy.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
CLIENT_IDENTITY=owner
# Preis je Minute für das App-Leg (Twilio Voice SDK)
CLIENT_RATE=0.004
# Eingehende Anrufe in die App: Twilio Push Credential (Typ apn, aus dem VoIP-Services-Zertifikat)
TWILIO_PUSH_CREDENTIAL_SID=
CLIENT_RING_SECONDS=20
# Zustand (Einstellungen der App, Kennzahlen je Gespräch) – im Container auf ein Volume legen
DATA_FILE=/app/data/state.json
# Voreinstellung "alle Anrufe direkt in die App" (wird in der App umgeschaltet)
DIRECT_TO_APP=0
