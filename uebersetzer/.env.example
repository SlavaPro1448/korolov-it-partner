# KI-Übersetzer für den Gottesdienst (RU<->DE). Als uebersetzer.env auf dem Server anlegen.
PORT=8080

# OpenAI
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe
TEXT_MODEL=gpt-5.4-mini
TTS_MODEL=gpt-4o-mini-tts
VOICE_RU=cedar
VOICE_DE=marin

# Zugangsschlüssel in den Links (openssl rand -hex 12)
OPERATOR_KEY=
LISTEN_KEY=

# Bremsen
MAX_LISTENERS=120
SESSION_MAX_MINUTES=240
